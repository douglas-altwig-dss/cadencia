# Copy to .env (never commit it). Every variable is optional.
# The Jira, calendar, collection, notification, AI and general values below can now be set in the
# app (Configuração → assistente) instead. This file is only the seed: once a value is saved in the
# app, the database wins over it ("Importar do .env" copies these into the database). Only the
# database URL, data dir, API token, CORS, logging and CADENCIA_SECRET_KEY stay env-only.
# See docs/config-store.md.
CADENCIA_JIRA_BASE_URL=https://sua-empresa.atlassian.net
CADENCIA_JIRA_EMAIL=voce@empresa.com
# Prefer the file secrets/jira_api_token (mounted at /run/secrets) over a token in this file.
CADENCIA_JIRA_API_TOKEN=

# Defaults for every board profile (each board can override them in the UI).
CADENCIA_TIMEZONE=America/Sao_Paulo
CADENCIA_CHECKPOINT_WEEKDAY=4
CADENCIA_CHECKPOINT_HOUR=18
CADENCIA_DEFAULT_SPRINT_WEEKS=2

# Local runs use SQLite; docker compose points this at PostgreSQL.
# CADENCIA_DATABASE_URL=sqlite:///./data/cadencia.db
# CADENCIA_COLLECT_INTERVAL_MINUTES=60
# CADENCIA_JIRA_MAX_CONCURRENCY=8
# CADENCIA_LOG_JSON=true

# Required on every API request when set (Authorization: Bearer ...). `make auth` generates it into
# secrets/api_token for the containers; set it here only for development.
# CADENCIA_API_TOKEN=

# Fernet key (urlsafe base64, 32 bytes) that encrypts the secrets saved in the app. Unset: a key is
# generated once into <data_dir>/secret.key (mode 0600). Losing it makes the saved secrets unreadable.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CADENCIA_SECRET_KEY=

# Where people open the web app, so notification messages can link back to it.
# CADENCIA_PUBLIC_URL=https://cadencia.empresa.com
# E-mail channels (Configuração → Notificações) send through this server.
# CADENCIA_SMTP_HOST=smtp.empresa.com
# CADENCIA_SMTP_PORT=587
# CADENCIA_SMTP_USER=
# CADENCIA_SMTP_PASSWORD=
# CADENCIA_SMTP_FROM=cadencia@empresa.com
# Largest template upload, in MB (nginx also caps uploads at 50m).
# CADENCIA_TEMPLATE_MAX_MB=50
